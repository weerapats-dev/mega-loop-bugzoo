# Where the synthetic traces go. Any Langfuse project works — local, langfuse-dev,
# or Cloud. Use a project of its OWN: these traces are not real runs, and mixing them
# with a real app's traces makes both sets untrustworthy.
LANGFUSE_HOST=http://localhost:3761
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Shows up as service.name on every span, so a shared project stays sortable.
BUGZOO_SERVICE_NAME=mega-loop-bugzoo
